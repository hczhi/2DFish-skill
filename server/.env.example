PORT=3001
NODE_ENV=production

# 必填 — JWT 签名密钥，生产环境必须设置为随机字符串（≥32字符）
# 生成方法: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-string

# 可选 — 允许跨域的前端域名（逗号分隔）
# 方案A（Node统一服务，同源）下可不设置
# 方案B（Nginx分流，API和前端不同域）下必须设置
# 示例: CORS_ORIGIN=https://qiaonx.com,https://www.qiaonx.com
# CORS_ORIGIN=

# 推荐 — 数据库中第三方密钥的加密密钥（AES-256-GCM）
# 生成方法: openssl rand -base64 48
#
# 不设则从 JWT_SECRET 派生，老部署无需配置也能正常跑。但那样一来
# 轮换 JWT_SECRET（一个只该影响 token 有效期的操作）会连带让库里所有
# 第三方密钥解不开，表现为 AI 调用/图片上传/飞书同步同时失败。
#
# 从派生切到显式配置：把 JWT_SECRET 当前的值原样抄到这里即可，
# 两者对同一字符串派生出同一把密钥，不需要重填任何后台配置。
# 之后再各自轮换互不影响。启动时会校验密钥是否变更并明确报错。
# CONFIG_ENCRYPTION_KEY=

# 平台 LLM key / 搜索 key / COS 凭据 / 飞书 App Secret 都在后台页面配置，
# 加密后存在数据库里，不放在本文件中。
